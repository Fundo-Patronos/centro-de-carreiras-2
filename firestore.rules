rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Fields the client must never write. `isAdmin` grants every endpoint
    // behind get_current_admin (the backend reads it straight off this
    // document), and `status` decides whether a mentor is publicly visible
    // and whether email verification has been satisfied. The backend writes
    // both through the Admin SDK, which bypasses these rules, so legitimate
    // changes are unaffected.
    function serverOwnedFields() {
      return ['role', 'uid', 'email', 'isAdmin', 'status'];
    }

    // Users collection
    match /users/{userId} {
      // Users can read their own profile
      allow read: if request.auth != null && request.auth.uid == userId;

      // Users can update their own profile, but never a server-owned field.
      allow update: if request.auth != null
                    && request.auth.uid == userId
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(serverOwnedFields());

      // Allow create if authenticated and uid matches. Signup legitimately
      // sets role and status; it must never hand itself isAdmin.
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.role in ['estudante', 'mentor']
                    && request.resource.data.get('isAdmin', false) == false;

      // No client-side delete
      allow delete: if false;
    }

    // Allow students to read active mentor profiles
    match /users/{userId} {
      allow read: if request.auth != null
                  && resource.data.role == 'mentor'
                  && resource.data.status == 'active';
    }
  }
}
